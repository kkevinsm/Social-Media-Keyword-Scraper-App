# Dapatkan di https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Nama file sesi login (berisi akses penuh ke akun Telegram Anda - JANGAN dibagikan/di-commit)
TG_SESSION=session/replybot

# Grup/channel yang dipantau, pisahkan koma. Bisa @username, t.me/username, atau id numerik
# (jalankan `python worker.py chats` untuk melihat id). Link undangan (t.me/+xxx) tidak didukung.
TG_CHATS=

# Dashboard ReplyBot & token (sama dengan INGESTION_SECRET_KEY di web/.env)
API_URL=https://reply-bot-app.vercel.app
INGEST_TOKEN=

